{
  "name": "tusa-promo",
  "version": "0.1.0",
  "private": true,
  "description": "TUSA.game promo videos built with Remotion",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render:sales": "remotion render src/index.ts TusaSales out/tusa-sales.mp4",
    "render:features": "remotion render src/index.ts TusaFeatures out/tusa-features.mp4",
    "render": "npm run render:sales && npm run render:features",
    "stills": "remotion still src/index.ts TusaSales out/sales-cover.png --frame=285 && remotion still src/index.ts TusaFeatures out/features-cover.png --frame=780",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/unbounded": "5.3.0",
    "@remotion/cli": "4.0.528",
    "@remotion/fonts": "4.0.528",
    "@remotion/transitions": "4.0.528",
    "material-symbols": "0.45.7",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "remotion": "4.0.528"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "typescript": "5.9.3"
  }
}
