# Neon is injected automatically by the Vercel Marketplace integration.
DATABASE_URL=

# Clerk is provisioned through the Vercel Marketplace integration.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Keep these server-only and set them in Vercel as sensitive values.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
GUEST_SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://tusa.game
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ABLY_API_KEY=
NEXT_PUBLIC_ABLY_CLIENT_ID=
TUSA_REQUIRE_DISTRIBUTED_SERVICES=false
BLOB_READ_WRITE_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
AUTH_EMAIL_FROM=TUSA.game <auth@tusa.game>
RESEND_WEBHOOK_SECRET=
# Optional development fallback when Resend is not configured.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_SECRET=
ADMIN_TOTP_SECRET=
# 32 random bytes encoded as base64. Required for database-backed MFA enrollment.
ADMIN_MFA_ENCRYPTION_KEY=
