{
  "name": "tusa-game",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.mjs tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test tests/e2e/accessibility.spec.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:verbose": "node scripts/migrate-database.mjs",
    "db:check": "drizzle-kit check",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "rag:build": "tsx scripts/rag-build.ts",
    "rag:search": "tsx scripts/rag-search.ts",
    "load:preflight": "node scripts/load-preflight.mjs",
    "certification:verify": "tsx scripts/verify-certification.ts",
    "certification:preflight": "tsx scripts/certification-preflight.ts",
    "test:certification": "npm run certification:preflight && playwright test tests/e2e/core-certification.spec.ts",
    "load:venue": "node scripts/venue-load.mjs",
    "check:canonical": "node scripts/check-canonical.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.17",
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/blob": "^2.6.1",
    "@vercel/speed-insights": "^2.0.0",
    "ably": "^2.24.0",
    "drizzle-orm": "^0.45.2",
    "material-symbols": "^0.45.7",
    "next": "^16.2.11",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.2.11",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.18",
    "sharp": "0.35.0"
  },
  "type": "module"
}
